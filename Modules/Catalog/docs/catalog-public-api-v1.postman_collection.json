        {
          "name": "Series facets — discover sample filters",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const missing = [\"series_path\"].filter(key => !String(pm.variables.get(key) || \"\"));",
                  "if (missing.length) {",
                  "    console.warn(\"Skipping \" + pm.info.requestName + \": set \" + missing.join(\", \") + \" in the selected environment, or run Tree / Facets first.\");",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Facets include counts and public value buckets\", function () {",
                  "        const data = pm.response.json().data;",
                  "        pm.expect(data.series.type).to.equal(\"series\");",
                  "        pm.expect(data.totalParts).to.be.at.least(0);",
                  "        pm.expect(data.facets).to.be.an(\"array\");",
                  "        data.facets.forEach(facet => {",
                  "            pm.expect(facet).to.include.all.keys(\"key\", \"label\", \"type\", \"values\");",
                  "            pm.expect(facet.values).to.be.an(\"array\");",
                  "            if (facet.type === \"file\") {",
                  "                pm.expect(facet.values).to.have.lengthOf(0);",
                  "            }",
                  "        });",
                  "    });",
                  "}",
                  "",
                  "if (pm.response.code === 200 && String(pm.variables.get(\"auto_discover\")).toLowerCase() === \"true\" &&",
                  "    !String(pm.variables.get(\"filter_key\") || \"\")) {",
                  "    const facet = pm.response.json().data.facets.find(item =>",
                  "        item.type !== \"file\" && Array.isArray(item.values) && item.values.some(bucket =>",
                  "            [\"string\", \"number\"].includes(typeof bucket.value) && String(bucket.value).length <= 255",
                  "        )",
                  "    );",
                  "    if (facet) {",
                  "        const buckets = facet.values.filter(bucket =>",
                  "            [\"string\", \"number\"].includes(typeof bucket.value) && String(bucket.value).length <= 255",
                  "        );",
                  "        pm.environment.set(\"filter_key\", facet.key);",
                  "        pm.environment.set(\"filter_value\", String(buckets[0].value));",
                  "        pm.environment.set(\"filter_value_2\", String((buckets[1] || buckets[0]).value));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/catalog/series/{{series_path_encoded}}/facets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "series",
                "{{series_path_encoded}}",
                "facets"
              ]
            },
            "description": "Returns unfiltered public facets. If filter_key is empty and auto_discover=true, captures a public non-file field and one or two actual facet values."
          },
          "response": []
        }
      ]
