        {
          "name": "Tree — discover real paths",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Tree is an array\", function () {",
                  "        pm.expect(pm.response.json().data).to.be.an(\"array\");",
                  "    });",
                  "}",
                  "",
                  "if (pm.response.code === 200 && String(pm.variables.get(\"auto_discover\")).toLowerCase() === \"true\") {",
                  "    const nodes = [];",
                  "    const pending = [...pm.response.json().data].reverse();",
                  "    while (pending.length) {",
                  "        const node = pending.pop();",
                  "        nodes.push(node);",
                  "        if (Array.isArray(node.children)) {",
                  "            pending.push(...[...node.children].reverse());",
                  "        }",
                  "    }",
                  "    const categories = nodes.filter(node => node.type === \"category\");",
                  "    const allSeries = nodes.filter(node => node.type === \"series\");",
                  "    const seriesPaths = new Set(allSeries.map(node => node.path));",
                  "    const candidates = allSeries.filter(node =>",
                  "        ![\"fields\", \"parts\", \"facets\"].some(suffix => seriesPaths.has(node.path + \"/\" + suffix))",
                  "    );",
                  "    const series = candidates.find(node => node.partCount > 0) || candidates[0];",
                  "    function fillEmpty(key, value) {",
                  "        if (!String(pm.variables.get(key) || \"\") && value !== undefined) {",
                  "            pm.environment.set(key, String(value));",
                  "        }",
                  "    }",
                  "    fillEmpty(\"category_path\", categories[0] && categories[0].path);",
                  "    fillEmpty(\"series_path\", series && series.path);",
                  "    const resolved = series || categories[0] || nodes[0];",
                  "    fillEmpty(\"resolve_path\", resolved && resolved.path);",
                  "    fillEmpty(\"search_term\", resolved && Array.from(resolved.name).slice(0, 100).join(\"\"));",
                  "    if (!series) {",
                  "        console.warn(\"No series found. Series requests will be skipped; add catalog data or supply series_path manually.\");",
                  "    }",
                  "    if (!categories.length) {",
                  "        console.warn(\"No category found. Category request will be skipped.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/catalog/tree",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "tree"
              ]
            },
            "description": "Run before path-specific requests. With auto_discover=true, fills empty environment variables using the first category and a series with parts when available. Avoids series whose child paths collide with reserved subroutes."
          },
          "response": []
        }
      ]
    },
