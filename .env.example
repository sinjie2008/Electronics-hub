APP_NAME="Electronics Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_DUMP_BINARY_PATH=
DB_DUMP_TIMEOUT=120

CATALOG_DB_CONNECTION=catalog
CATALOG_DB_HOST=127.0.0.1
CATALOG_DB_PORT=3306
CATALOG_DB_DATABASE=
CATALOG_DB_USERNAME=
CATALOG_DB_PASSWORD=
CATALOG_DB_SOCKET=
CATALOG_ROUTE_PREFIX=catalog
CATALOG_BASE_URL=
CATALOG_STORAGE_ROOT=
CATALOG_TYPST_BIN=typst
CATALOG_PDFLATEX_BIN=pdflatex

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_QUEUE_RETRY_AFTER=960
REDIS_DB=0
REDIS_CACHE_DB=1

SCOUT_DRIVER=database
SCOUT_QUEUE=false

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_NAME=enterprise
BACKUP_DISK=backups
BACKUP_SCHEDULE_ENABLED=false
BACKUP_RUN_AT=02:00
BACKUP_CLEAN_AT=03:00
BACKUP_NOTIFICATION_EMAIL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
MODULE_STATUSES_PATH=
BACKUP_ARCHIVE_PASSWORD=
